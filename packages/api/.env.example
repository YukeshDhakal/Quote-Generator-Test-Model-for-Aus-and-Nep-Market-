# Copy this file to .env and fill in real values. Never commit .env - only this template.

# Postgres connection string (Supabase session pooler recommended for local dev). REQUIRED - the
# app fails to boot without it.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Comma-separated list of origins allowed to call this API with credentials (CORS). Defaults to
# http://localhost:5183 if unset. Add a second origin during a domain migration, e.g.
# "https://old.example.com,https://new.example.com".
WEB_ORIGIN=http://localhost:5183

# Port the API listens on. Defaults to 5187 if unset.
PORT=5187

# "development" (default) or "production". Controls cookie Secure flag, Puppeteer sandboxing
# flags, and other env-conditional behavior - never hardcode either value, always set this.
NODE_ENV=development

# Google OAuth client ID/secret (Google Cloud Console > Credentials). Optional: Google sign-in
# and Gmail send both cleanly disable themselves if these are unset. GOOGLE_CLIENT_SECRET is
# only needed for Gmail send (authorization-code flow), not for the sign-in button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URI registered for the Gmail OAuth client in Google Cloud Console. Defaults to
# http://localhost:5187/api/auth/google/callback if unset - only override for a non-default port.
GMAIL_REDIRECT_URI=http://localhost:5187/api/auth/google/callback

# Base64-encoded 32-byte AES-256-GCM key used to encrypt Gmail refresh tokens at rest. Required
# (and validated at boot) only if GOOGLE_CLIENT_ID/SECRET are both set. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# "console" (default, logs the composed email instead of sending - safe for local dev),
# "file" (writes .eml files to data/outbox/), or "gmail" (really sends via the Gmail API).
# Never defaults to gmail - must be explicitly set to send real email.
MAIL_MODE=console

# Set to "true" to force the session cookie's SameSite=None (cross-site) instead of the default
# Lax. Only needed mid-domain-migration when the API and web app are on different registrable
# domains - see the comment above sessionCookieOptions in auth.ts.
COOKIE_CROSS_SITE=
